# Secrets
.env
*.db
*.sqlite
*.key
*.pem
.credentials/
credentials*
service-account-key.json

# OS
.DS_Store
node_modules/
__pycache__/
*.pyc

# Prevent personal workspace data from leaking in
workspace/inbox/*
workspace/projects/*
workspace/summaries/*
workspace/handoff/*
# Transcripts are verbatim records of real meetings, and this repo is public.
# The audio buffer underneath them is the recordings themselves.
workspace/transcripts/*
!workspace/inbox/YYYY-MM-DD-example.md
