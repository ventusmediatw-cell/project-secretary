# Secrets
.env
*.db
*.sqlite
*.key
*.pem
.credentials/
credentials*
service-account-key.json

# OS
.DS_Store
node_modules/
__pycache__/
*.pyc

# Prevent personal workspace data from leaking in.
# The `!` lines re-include ONLY an empty .gitkeep per folder, so a fresh clone
# arrives with the folder structure the Skills expect. Contents stay ignored.
# Without them git drops the empty folders entirely, and the startup flow's
# `Scan handoff/pending/` step then silently reports "no pending handoffs".
workspace/inbox/*
!workspace/inbox/YYYY-MM-DD-example.md

workspace/projects/*
!workspace/projects/.gitkeep

workspace/summaries/*
!workspace/summaries/weekly/
!workspace/summaries/monthly/
workspace/summaries/weekly/*
!workspace/summaries/weekly/.gitkeep
workspace/summaries/monthly/*
!workspace/summaries/monthly/.gitkeep

workspace/handoff/*
!workspace/handoff/pending/
!workspace/handoff/done/
workspace/handoff/pending/*
!workspace/handoff/pending/.gitkeep
workspace/handoff/done/*
!workspace/handoff/done/.gitkeep

# Skill-private glossaries and skill-ops local state — never ship these.
workspace/.claude/skills/*/references/_private-*.md
workspace/.claude/.last-skillops-sweep
workspace/.claude/.last-skillops-nudge-run

# Transcripts are verbatim records of real meetings, and this repo is public.
# The audio buffer underneath them is the recordings themselves.
workspace/transcripts/*
!workspace/transcripts/.gitkeep
